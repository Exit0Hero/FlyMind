# FlyMind Environment Configuration
# Copy to .env and adjust as needed. ALL variables are optional and use the
# FLYMIND_ prefix. Never commit a real .env to the repository.

# --- Runtime environment ----------------------------------------------------
# dev | test | prod   (prod forbids the CORS wildcard)
FLYMIND_ENV=dev

# --- Service identity -------------------------------------------------------
FLYMIND_APP_NAME=FlyMind API
FLYMIND_APP_VERSION=1.0.0
FLYMIND_DEBUG=false
FLYMIND_HOST=0.0.0.0
FLYMIND_PORT=8001

# --- CORS --------------------------------------------------------------------
# JSON array string or comma-separated list of allowed browser origins.
# Only relevant when clients talk to the API directly (NEXT_PUBLIC_API_URL);
# the Next.js rewrite proxy is same-origin.
FLYMIND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Paths -------------------------------------------------------------------
# Defaults are resolved relative to the project root when unset.
FLYMIND_DATA_ROOT=./data
FLYMIND_MODELS_DIR=./models
FLYMIND_REPORTS_DIR=./results/reports

# --- Model artifacts ----------------------------------------------------------
FLYMIND_MODEL_FILENAME=link_prediction_rf.pkl
FLYMIND_MODEL_METADATA_FILENAME=link_prediction_rf.metadata.json
FLYMIND_MODEL_VERSION=FlyMind-RF v1.0.0
# Verify the artifact SHA-256 against metadata before serving.
FLYMIND_ENABLE_MODEL_INTEGRITY_CHECK=true

# --- Resource limits ----------------------------------------------------------
FLYMIND_MAX_CANDIDATES=1000
FLYMIND_MAX_K=100
FLYMIND_DEFAULT_CANDIDATES=100
FLYMIND_MAX_SEARCH_LIMIT=100
FLYMIND_MAX_SEARCH_LENGTH=128

# --- Observability ------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
FLYMIND_LOG_LEVEL=INFO

# --- Legacy Streamlit dashboard (unrelated to the FastAPI backend) ------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true