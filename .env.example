# FlyMind Environment Configuration
# Copy to .env and adjust as needed

# Data root (default: ./data/processed)
FLYMIND_DATA_ROOT=./data/processed

# Model directory (default: ./models)
FLYMIND_MODEL_DIR=./models

# Model version (for display)
FLYMIND_MODEL_VERSION=FlyMind-RF v1.0.0

# Candidate ranking limits
FLYMIND_DEFAULT_CANDIDATES=100
FLYMIND_MAX_CANDIDATES=1000

# Logging level
FLYMIND_LOG_LEVEL=INFO

# Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
